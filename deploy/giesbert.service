[Unit]
Description=Giesbert (Gieß-Erinnerung)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Eigener, automatisch angelegter Systembenutzer ohne Anmeldung
DynamicUser=yes
# Datenbank liegt in /var/lib/giesbert (wird automatisch angelegt)
StateDirectory=giesbert
WorkingDirectory=/var/www/giesbert
Environment=TZ=Europe/Berlin
EnvironmentFile=-/etc/giesbert.env
ExecStart=/usr/bin/python3 /var/www/giesbert/server.py --host 127.0.0.1 --port 8090 --db /var/lib/giesbert/giesbert.db
Restart=on-failure
RestartSec=3

# Absicherung
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# AF_INET/AF_INET6 auch für ausgehende Anfragen an Wikipedia (Pflanzenbilder)
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
